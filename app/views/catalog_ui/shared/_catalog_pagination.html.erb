
<%
  pagination_enabled =
    collection.respond_to?(:total_pages) &&
    collection.total_pages.to_i > 1

  current_offset =
    if collection.respond_to?(:offset_value)
      collection.offset_value.to_i
    else
      0
    end

  current_page_count =
    if collection.respond_to?(:limit_value) && collection.limit_value
      [collection.size, collection.limit_value.to_i].min
    else
      collection.size
    end

  total_count =
    if collection.respond_to?(:total_count)
      collection.total_count.to_i
    else
      collection.size
    end

  first_item = total_count.positive? ? current_offset + 1 : 0
  last_item = [current_offset + current_page_count, total_count].min

  pagination_filters =
    if local_assigns[:filtros].respond_to?(:compact_blank)
      filtros.compact_blank
    elsif local_assigns[:filtros].respond_to?(:to_h)
      filtros.to_h.reject { |_key, value| value.blank? }
    else
      {}
    end

  pagination_params = pagination_filters.merge(
    view: params[:view].presence
  ).compact_blank
%>

<% if pagination_enabled %>
  <div class="catalog-pagination-wrapper">
    <div class="catalog-pagination-info">
      Mostrando
      <strong><%= first_item %></strong> -
      <strong><%= last_item %></strong>
      de
      <strong><%= total_count %></strong>
      <%= label %>
    </div>

    <div class="catalog-pagination-nav">
      <%= paginate collection,
          params: pagination_params,
          window: 2,
          outer_window: 1 %>
    </div>
  </div>
<% end %>
