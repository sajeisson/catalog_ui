<% if collection.total_pages > 1 %>
  <div class="catalog-pagination-wrapper">
    <div class="catalog-pagination-info">
      Mostrando <strong><%= collection.offset_value + 1 %></strong> - 
      <strong><%= [collection.offset_value + collection.length, collection.total_count].min %></strong>
      de <strong><%= collection.total_count %></strong> <%= label %>
    </div>

    <div class="catalog-pagination-nav">
      <%= paginate collection,
          params: { q: filtros.compact_blank, view: params[:view] },
          window: 2,
          outer_window: 1 %>
    </div>
  </div>
<% end %>