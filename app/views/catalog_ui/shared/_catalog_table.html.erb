
<div class="catalog-table-responsive">
  <table class="catalog-table">
    <thead>
      <tr>
        <th scope="col">#</th>

        <% columns.each do |col| %>
          <th scope="col" class="<%= 'text-center' if col[:center] %>">
            <% if col[:sortable] %>
              <%= link_to sort_url(col[:attribute], current_sort: params[:sort]),
                          class: "sortable-header #{params[:sort].to_s.match?(/\A#{Regexp.escape(col[:attribute].to_s)}_(asc|desc)\z/) ? 'active' : ''}" do %>
                <%= col[:header] %>
                <%= sort_icon(col[:attribute], current_sort: params[:sort]) %>
              <% end %>
            <% else %>
              <%= col[:header] %>
            <% end %>
          </th>
        <% end %>

        <th scope="col" class="text-center">Acciones</th>
      </tr>
    </thead>

    <tbody>
      <% if collection.present? %>
        <% collection.each_with_index do |item, index| %>
          <%
            namespace_parts = Array(local_assigns[:routes_namespace]).compact
            resource = local_assigns[:resource_name].presence || item.class.name.underscore

            valid_route_parts = (namespace_parts + [resource]).all? do |part|
              part.to_s.match?(/\A[a-zA-Z_]\w*\z/)
            end

            raise ArgumentError, 'Namespace o nombre de recurso no válido' unless valid_route_parts

            route_prefix = namespace_parts.any? ? "#{namespace_parts.join('_')}_" : ''

            show_helper = "#{route_prefix}#{resource}_path"
            edit_helper = "edit_#{route_prefix}#{resource}_path"

            show_url = public_send(show_helper, item) if respond_to?(show_helper)
            edit_url = public_send(edit_helper, item) if respond_to?(edit_helper)

            row_number =
              if collection.respond_to?(:offset_value)
                collection.offset_value + index + 1
              else
                index + 1
              end
          %>

          <tr>
            <td><%= row_number %></td>

            <% columns.each do |col| %>
              <td class="<%= 'text-center' if col[:center] %>">
                <%= render_catalog_cell(item, col, search_term: search_term) %>
              </td>
            <% end %>

            <td>
              <div class="catalog-actions">
                <% if show_url %>
                  <%= link_to show_url,
                              class: 'action-btn',
                              title: 'Ver',
                              aria: { label: 'Ver registro' } do %>
                    <i class="bi bi-eye" aria-hidden="true"></i>
                  <% end %>

                  <%= button_to show_url,
                                method: :delete,
                                form: {
                                  data: {
                                    turbo_confirm: '¿Estás seguro de que quieres eliminar este registro?'
                                  }
                                },
                                class: 'action-btn danger p-0 border-0 bg-transparent',
                                title: 'Eliminar',
                                aria: { label: 'Eliminar registro' } do %>
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                  <% end %>
                <% end %>

                <% if edit_url %>
                  <%= link_to edit_url,
                              class: 'action-btn',
                              title: 'Editar',
                              aria: { label: 'Editar registro' } do %>
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="<%= columns.size + 2 %>">
            <%= render 'catalog_ui/shared/catalog_empty_state',
                       search_term: search_term,
                       clear_path: clear_path,
                       new_path: new_path %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
