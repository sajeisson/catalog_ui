<div class="catalog-table-responsive">
  <table class="catalog-table">
    <thead>
      <tr>
        <th>#</th>
        <% columns.each do |col| %>
          <th class="<%= 'text-center' if col[:center] %>">
            <% if col[:sortable] %>
              <%= link_to sort_url(col[:attribute], current_sort: params[:sort]),
                  class: "sortable-header #{params[:sort]&.start_with?(col[:attribute].to_s) ? 'active' : ''}" do %>
                <%= col[:header] %>
                <%= sort_icon(col[:attribute], current_sort: params[:sort]) %>
              <% end %>
            <% else %>
              <%= col[:header] %>
            <% end %>
          </th>
        <% end %>
        <th class="text-center">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% if collection.present? && collection.total_count > 0 %>
        <% collection.each_with_index do |item, index| %>
          <% 
            ns = Array(local_assigns[:routes_namespace]).compact
            resource = local_assigns[:resource_name] || item.class.name.underscore
            
            show_url = ns.any? ? send("#{ns.join('_')}_#{resource}_path", item) : send("#{resource}_path", item)
            edit_url = ns.any? ? send("edit_#{ns.join('_')}_#{resource}_path", item) : send("edit_#{resource}_path", item)
          %>
          <tr>
            <td><%= collection.offset_value + index + 1 %></td>

            <% columns.each do |col| %>
              <td class="<%= 'text-center' if col[:center] %>">
                <%= render_catalog_cell(item, col, search_term: search_term) %>
              </td>
            <% end %>

            <td>
              <div class="catalog-actions">
                <%= link_to show_url, class: "action-btn", title: "Ver" do %>
                  <i class="bi bi-eye"></i>
                <% end %>

                <%= link_to edit_url, class: "action-btn", title: "Editar" do %>
                  <i class="bi bi-pencil"></i>
                <% end %>

                <%= button_to show_url,
                    method: :delete,
                    data: { turbo_confirm: '¿Estás seguro de que quieres eliminar este registro?' },
                    class: "action-btn danger p-0 border-0 bg-transparent",
                    title: "Eliminar" do %>
                  <i class="bi bi-trash3"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="<%= columns.size + 2 %>">
            <%= render 'catalog_ui/shared/catalog_empty_state',
                search_term: search_term,
                clear_path: clear_path,
                new_path: new_path %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
