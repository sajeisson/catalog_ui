
<%
  actions = local_assigns.key?(:actions) ?
    Array(local_assigns[:actions]).map(&:to_sym) :
    [:show, :edit, :destroy]

  actions &= [:show, :edit, :destroy]
%>

<div class="catalog-cards-grid">
  <% if collection.present? %>
    <% collection.each_with_index do |item, index| %>
      <%
        namespace_parts = Array(local_assigns[:routes_namespace]).compact
        resource = local_assigns[:resource_name].presence || item.class.name.underscore

        route_parts = namespace_parts + [resource]

        valid_route_parts = route_parts.all? do |part|
          part.to_s.match?(/\A[a-zA-Z_]\w*\z/)
        end

        raise ArgumentError, 'Namespace o nombre de recurso no válido' unless valid_route_parts

        route_prefix = namespace_parts.any? ? "#{namespace_parts.join('_')}_" : ''

        show_helper = "#{route_prefix}#{resource}_path"
        edit_helper = "edit_#{route_prefix}#{resource}_path"

        show_url =
          public_send(show_helper, item) if respond_to?(show_helper)

        edit_url =
          public_send(edit_helper, item) if respond_to?(edit_helper)

        row_number =
          if collection.respond_to?(:offset_value)
            collection.offset_value + index + 1
          else
            index + 1
          end
      %>

      <div class="catalog-card">
        <div class="catalog-card-header">
          <span class="catalog-card-number">
            #<%= row_number %>
          </span>

          <% if actions.any? %>
            <div class="catalog-card-actions">

              <% if actions.include?(:show) && show_url %>
                <%= link_to show_url,
                            class: 'action-btn',
                            title: 'Ver',
                            aria: { label: 'Ver registro' } do %>
                  <i class="bi bi-eye" aria-hidden="true"></i>
                <% end %>
              <% end %>

              <% if actions.include?(:edit) && edit_url %>
                <%= link_to edit_url,
                            class: 'action-btn',
                            title: 'Editar',
                            aria: { label: 'Editar registro' } do %>
                  <i class="bi bi-pencil" aria-hidden="true"></i>
                <% end %>
              <% end %>

              <% if actions.include?(:destroy) && show_url %>
                <%= button_to show_url,
                              method: :delete,
                              form: {
                                data: {
                                  turbo_confirm: '¿Estás seguro de que quieres eliminar este registro?'
                                }
                              },
                              class: 'action-btn danger p-0 border-0 bg-transparent',
                              title: 'Eliminar',
                              aria: { label: 'Eliminar registro' } do %>
                  <i class="bi bi-trash3" aria-hidden="true"></i>
                <% end %>
              <% end %>

            </div>
          <% end %>
        </div>

        <div class="catalog-card-body">
          <% columns.each do |col| %>
            <div class="catalog-card-field <%= 'text-center' if col[:center] %>">
              <span class="catalog-card-label">
                <%= col[:header] %>
              </span>

              <span class="catalog-card-value">
                <%= render_catalog_cell(
                  item,
                  col,
                  search_term: search_term
                ) %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= render 'catalog_ui/shared/catalog_empty_state',
               search_term: search_term,
               clear_path: clear_path,
               new_path: new_path %>
  <% end %>
</div>
