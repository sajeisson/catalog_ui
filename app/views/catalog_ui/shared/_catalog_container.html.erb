
<%# 
  Variables esperadas:
    - title: String
    - icon: String (clase de Bootstrap Icons)
    - new_path: Path
    - export_path: Path (opcional)
    - search_path: Path
    - clear_path: Path
    - collection: Colección de registros
    - columns: Array de definiciones de columnas
    - filters: Hash de definición de filtros
    - search_term: String (opcional)
    - new_button_text: String (opcional)
    - routes_namespace: Namespace de rutas (opcional)
    - resource_name: Nombre del recurso (opcional)
%>

<%
  filters ||= {}
  columns ||= []
  search_term = local_assigns[:search_term]
  new_button_text ||= 'Nuevo'

  total_count =
    if collection.respond_to?(:total_count)
      collection.total_count
    else
      collection.size
    end

  # Conserva búsqueda, filtros, ordenamiento y vista al paginar.
  # La paginación debe establecer su propio parámetro page.
  pagination_filters = request.query_parameters
                                      .except('page')
                                      .compact_blank

  pagination_label = title.to_s.downcase.split.last || 'registros'
%>

<div class="container-fluid container-with-margin-index">
  <%= auto_breadcrumb if respond_to?(:auto_breadcrumb) %>

  <div class="catalog-container">

    <%# ENCABEZADO %>
    <%= render 'catalog_ui/shared/catalog_header',
               title: title,
               icon: icon,
               new_path: new_path,
               export_path: local_assigns[:export_path],
               new_button_text: new_button_text %>

    <%# FILTROS %>
    <%= render 'catalog_ui/shared/catalog_filters',
               search_path: search_path,
               clear_path: clear_path,
               filters: filters %>

    <%# INFORMACIÓN DE BÚSQUEDA %>
    <% if search_term.present? %>
      <%= render 'catalog_ui/shared/catalog_search_info',
                 search_term: search_term,
                 total_count: total_count,
                 clear_path: clear_path %>
    <% end %>

    <%# BARRA DE HERRAMIENTAS %>
    <div class="catalog-view-toolbar">
      <div class="catalog-result-count">
        <%= total_count %>
        <%= total_count == 1 ? 'registro' : 'registros' %>
      </div>

      <div class="catalog-view-toggle">
        <%= link_to view_toggle_url('table'),
                    class: "view-btn #{current_view_mode == 'table' ? 'active' : ''}",
                    title: 'Vista tabla',
                    aria: { label: 'Vista tabla' },
                    aria_current: (current_view_mode == 'table' ? 'page' : nil) do %>
          <i class="bi bi-table" aria-hidden="true"></i>
        <% end %>

        <%= link_to view_toggle_url('cards'),
                    class: "view-btn #{current_view_mode == 'cards' ? 'active' : ''}",
                    title: 'Vista tarjetas',
                    aria: { label: 'Vista tarjetas' },
                    aria_current: (current_view_mode == 'cards' ? 'page' : nil) do %>
          <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
        <% end %>
      </div>
    </div>

    <%# TABLA O TARJETAS %>
    <% if current_view_mode == 'cards' %>
      <%= render 'catalog_ui/shared/catalog_cards',
                 collection: collection,
                 columns: columns,
                 search_term: search_term,
                 new_path: new_path,
                 clear_path: clear_path,
                 routes_namespace: local_assigns[:routes_namespace],
                 resource_name: local_assigns[:resource_name] %>
    <% else %>
      <%= render 'catalog_ui/shared/catalog_table',
                 collection: collection,
                 columns: columns,
                 search_term: search_term,
                 new_path: new_path,
                 clear_path: clear_path,
                 routes_namespace: local_assigns[:routes_namespace],
                 resource_name: local_assigns[:resource_name] %>
    <% end %>

    <%# PAGINACIÓN %>
    <% if collection.respond_to?(:total_pages) && collection.total_pages > 1 %>
      <%= render 'catalog_ui/shared/catalog_pagination',
                 collection: collection,
                 label: pagination_label,
                 filtros: pagination_filters %>
    <% end %>

  </div>
</div>

<%= render 'shared/footer' if lookup_context.exists?('shared/footer', [], true) %>
